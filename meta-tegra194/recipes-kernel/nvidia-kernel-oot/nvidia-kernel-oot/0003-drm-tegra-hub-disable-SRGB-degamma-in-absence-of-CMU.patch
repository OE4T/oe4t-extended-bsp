From 0281d1f23c31006dda8fa16309c09cf6ebe8c96e Mon Sep 17 00:00:00 2001
From: Kurt Kiefer <kekiefer@gmail.com>
Date: Mon, 19 Jan 2026 11:26:00 -0800
Subject: [PATCH] drm/tegra: hub: disable SRGB degamma in absence of CMU
 support

Outputs downstream of these windows set up in the hub do not enable
the CMU, so sRGB degamma here results in a linear gamma that is not
reasonable for output. Both DisplayPort and HDMI RGB outputs expect
and sRGB output, so just leave this alone in the window.

Upstream-Status: Pending
---
 nvidia-oot/drivers/gpu/drm/tegra/hub.c | 3 ---
 1 file changed, 3 deletions(-)

diff --git a/nvidia-oot/drivers/gpu/drm/tegra/hub.c b/nvidia-oot/drivers/gpu/drm/tegra/hub.c
index 9ba941a..a31e28c 100644
--- a/nvidia-oot/drivers/gpu/drm/tegra/hub.c
+++ b/nvidia-oot/drivers/gpu/drm/tegra/hub.c
@@ -702,9 +702,6 @@ static void tegra_shared_plane_atomic_update(struct drm_plane *plane,
 
 		/* XXX parameterize */
 		value |= COLOR_SPACE_YUV_2020;
-	} else {
-		if (!tegra_plane_format_is_indexed(tegra_plane_state->format))
-			value |= DEGAMMA_SRGB;
 	}
 
 	tegra_plane_writel(p, value, DC_WIN_SET_PARAMS);
